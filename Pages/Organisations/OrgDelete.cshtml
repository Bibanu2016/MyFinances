@page
@model MyFinances.Pages.Organisations.DeleteModel

@{
    Layout = "_Layout";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete</title>
</head>
<body>

<h3 style="color: red">Are you sure you want to delete this?</h3>
<div style="text-align:center">
    <h4>Organisation</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Organisation.IdCateg)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Organisation.IdCateg)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Organisation.OrganisationName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Organisation.OrganisationName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Organisation.OrganisationDetails)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Organisation.OrganisationDetails)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Organisation.NumberContracts)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Organisation.NumberContracts)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Organisation.IdOrg" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./OrgIndex">Back to List</a>
    </form>
</div>
</body>
</html>
