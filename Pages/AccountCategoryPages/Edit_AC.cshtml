@page "{id:int}"
@model MyFinances.Pages.AccountCategoryPages.Edit_ACModel
@{
}
<h1>@ViewData["Title"]</h1>
<br />
<hr />
<br />
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="AccCategEdit.IdAccountCategory" />
    <div class="container container-sm">
        <div class="row row-cols-6 py-2">
            <div class="col-2">
                <label class="form-label" asp-for="AccCategEdit.IdAccountClass"></label>
            </div>
            <div class="col-4">
                <input type="hidden" asp-for="AccCategEdit.IdAccountClass" />
                <input type="text" asp-for="AccClassName" disabled />
            </div>
        </div>
        <div class="row row-cols-6 py-2">
            <div class="col-2">
                <label class="form-label" asp-for="AccCategEdit.AccountCategoryName"></label>
            </div>
            <div class="col-4">
                <input type="text" asp-for="AccCategEdit.AccountCategoryName" />
                <span class="text-danger" asp-validation-for="AccCategEdit.AccountCategoryName"></span>
            </div>
        </div>
        <div class="row row-cols-6 py-2">
            <div class="col-2">
                <label class="form-label" asp-for="AccCategEdit.IdContractCategory"></label>
            </div>
            <div class="col-4">
                <select class="form-select" asp-for="AccCategEdit.IdContractCategory" asp-items="@Model.ContTypeList">
                    <option>Choose ..</option>
                </select>
                <span class="text-danger" asp-validation-for="AccCategEdit.IdContractCategory"></span>
            </div>
        </div>
        <div class="row row-cols-6 py-2">
            <div class="col-2">
                <label class="form-label" asp-for="AccCategEdit.IdCashFlow"></label>
            </div>
            <div class="col-4">
                <select class="form-select" asp-for="AccCategEdit.IdCashFlow" asp-items="@Model.CashFlowList">
                    <option>Choose ..</option>
                </select>
                <span class="text-danger" asp-validation-for="AccCategEdit.IdCashFlow"></span>
            </div>
        </div>
        <div class="row row-cols-6">
            <div class="col-2">
                <label class="form-label" asp-for="AccCategEdit.CategoryRoles"></label>
                <span asp-validation-for="AccCategEdit.CategoryRoles" class="text-danger"></span>
            </div>
            <div class="col-4">
                <input type="hidden" asp-for="AccCategEdit.CategoryRoles" />
                <div class="form-check">
                    <input type="text" asp-for="StringCategRole" disabled />
                </div>
            </div>
        </div>
        <div class="row row-cols-6">
            <div class="col-2"></div>
            <div class="col-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="CRole.PaymentAsset" id="role_0">
                    <label class="form-check-label" for="role_0">Payment asset</label>
                </div>
            </div>
        </div>
        <div class="row row-cols-6">
            <div class="col-2"></div>
            <div class="col-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="CRole.PaymentLiability" id="role_1">
                    <label class="form-check-label" for="role_1">Payment liability</label>
                </div>
            </div>
        </div>
        <div class="row row-cols-6">
            <div class="col-2"></div>
            <div class="col-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="CRole.ImportTransaction" id="role_2">
                    <label class="form-check-label" for="role_2">Import transacions</label>
                </div>
            </div>
        </div>
        <div class="row row-cols-6">
            <div class="col-2"></div>
            <div class="col-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="CRole.InvestmentFund" id="role_3">
                    <label class="form-check-label" for="role_3">Investment Management Fund</label>
                </div>
            </div>
        </div>
        <div class="row row-cols-6">
            <div class="col-2"></div>
            <div class="col-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="CRole.Tax" id="role_4">
                    <label class="form-check-label" for="role_4">Tax</label>
                </div>
            </div>
        </div>
        <div class="row row-cols-6">
            <div class="col-2"></div>
            <div class="col-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="CRole.UserAccount" id="role_5">
                    <label class="form-check-label" for="role_5">User accounts</label>
                </div>
            </div>
        </div>
        <div class="row row-cols-6">
            <div class="col-2"></div>
            <div class="col-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="CRole.Spare" id="role_6">
                    <label class="form-check-label" for="role_6">Spare</label>
                </div>
            </div>
        </div>
        <div class="row row-cols-6 py-4">
            <div class="col-2"></div>
            <div class="col-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="CRole.Locked" id="role_7">
                    <label class="form-check-label" for="role_7">Locked</label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-5"></div>
            <div class="col-1">
                <button type="submit" class="btn btn-primary" value="Update">Update</button>
            </div>
        </div>
    </div>
</form>

<div class="row">
    <a asp-page="./Index_AC">Home</a>
</div>