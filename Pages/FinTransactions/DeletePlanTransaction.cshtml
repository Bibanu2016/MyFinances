@page
@model MyFinances.Pages.FinTransactions.DeletePlanTransactionModel
@{
}

<h1 class="text-danger">@ViewData["Title"]</h1>
<br />
<form method="post" class="container container-sm">
    <input type="hidden" asp-for="MyPlanTransaction.IdTransaction" />
    <table class="table-primary table-borderless">
        <thead>
            <tr>
                <th><strong>Detail</strong></th>
                <th><strong>Value</strong></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td style="padding-right:5px">@Html.DisplayNameFor(p=>p.MyPlanTransaction.TransactionDate)</td>
                <td>@Model.MyPlanTransaction.TransactionDate.ToShortDateString()</td>
            </tr>
            <tr>
                <td>@Html.DisplayNameFor(p => p.MyPlanTransaction.DebitAccount)</td>
                <td>@Model.MyPlanTransaction.DebitAccount - @Model.FAList.FirstOrDefault(predicate => predicate.Value == Model.MyPlanTransaction.DebitAccount.ToString())?.Text</td>
            </tr>
            <tr>
                <td style="padding-right:5px">@Html.DisplayNameFor(p => p.MyPlanTransaction.CreditAccount)</td>
                <td>@Model.MyPlanTransaction.CreditAccount - @Model.FAList.FirstOrDefault(predicate => predicate.Value == Model.MyPlanTransaction.CreditAccount.ToString())?.Text</td>
            </tr>
            <tr>
                <td style="padding-right:5px">@Html.DisplayNameFor(p => p.MyPlanTransaction.TransactionValue)</td>
                <td>@Model.MyPlanTransaction.TransactionValue </td>
            </tr>
            <tr>
                <td style="padding-right:5px">@Html.DisplayNameFor(p => p.MyPlanTransaction.TransactionDetail)</td>
                <td>@Model.MyPlanTransaction.TransactionDetail</td>
            </tr>
            <tr>
                <td style="padding-right:5px">@Html.DisplayNameFor(p => p.MyPlanTransaction.IdSource)</td>
                <td>@Model.MyPlanTransaction.IdSource - @Model.FAList.FirstOrDefault(predicate => predicate.Value == Model.MyPlanTransaction.IdSource.ToString())?.Text</td>
            </tr>
            <tr>
                <td style="padding-right:5px">@Html.DisplayNameFor(p => p.MyPlanTransaction.ContractIdentifier)</td>
                <td>@Model.MyPlanTransaction.ContractIdentifier - @Model.FAList.FirstOrDefault(predicate => predicate.Value == Model.MyPlanTransaction.ContractIdentifier.ToString())?.Text</td>
            </tr>
            <tr>
                <td style="padding-right:5px">@Html.DisplayNameFor(p => p.MyPlanTransaction.ExecutedTransaction)</td>
                <td>@Model.MyPlanTransaction.ExecutedTransaction</td>
            </tr>
        </tbody>
    </table>
    <br />
    <div class="row">
        <div class="col col-6">
            <a class="btn btn-secondary" asp-page="./FutureTransactions">Cancel</a>
        </div>
        <div class="col col-auto align-content-end">
            <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#confirmActionModal">
                Delete
            </button>
        </div>
    </div>
    <div class="modal fade" id="confirmActionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:coral">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete transaction with id: @Model.MyPlanTransaction.IdTransaction ?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Yes, delete</button>
                </div>

            </div>
        </div>
    </div>
</form>
