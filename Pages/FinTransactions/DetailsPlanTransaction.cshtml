@page
@model MyFinances.Pages.FinTransactions.DetailsPlanTransactionModel

@{
}

<h1>@ViewData["Title"]</h1>

<hr />

<div class="container container-sm">
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PlanTransaction.ContractIdentifier)
        </dt>
        <dd class="col-sm-10">
            @Model.ContractName
        </dd>
        @if(Model.PlanTransaction.TransactionDate <= DateTime.Today)
        {
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.PlanTransaction.TransactionDate)
            </dt>
            <dd class="col-sm-10" style="color:indianred">
                @Model.PlanTransaction.TransactionDate.ToShortDateString()
            </dd>
        }
        else
        {
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.PlanTransaction.TransactionDate)
            </dt>
            <dd class="col-sm-10">
                @Model.PlanTransaction.TransactionDate.ToShortDateString()
            </dd>
        }
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PlanTransaction.DebitAccount)
        </dt>
        <dd class="col-sm-10">
            [@Html.DisplayFor(model => model.PlanTransaction.DebitAccount)] @Model.DebitName
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PlanTransaction.CreditAccount)
        </dt>
        <dd class="col-sm-10">
            [@Html.DisplayFor(model => model.PlanTransaction.CreditAccount)] @Model.CreditName
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PlanTransaction.TransactionValue)
        </dt>
        <dd class="col-sm-10">
            $ @Html.DisplayFor(model => model.PlanTransaction.TransactionValue)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PlanTransaction.TransactionDetail)
        </dt>
        <dd class="col-sm-10">
            @Model.DetailTransaction
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PlanTransaction.IdSource)
        </dt>
        <dd class="col-sm-10">
            [@Html.DisplayFor(model => model.PlanTransaction.IdSource)] @Model.SourceName
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PlanTransaction.ExecutedTransaction)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PlanTransaction.ExecutedTransaction)
        </dd>
    </dl>
    <hr />
    <div class="row">
        <div class="col col-6"></div>
        <div class="col align-content-end">
            <a class="link-dark" asp-page="./EditPlanTransaction" asp-route-id="@Model.PlanTransaction.IdTransaction">Edit</a>
        </div>
    </div>
</div>
<hr />
<div class="row">
    <a class="link" asp-page="./FutureTransactions">Back to List</a>
</div>
