@page
@model MyFinances.Pages.FinTransactions.EditFinTransactionModel
@{
    ViewBag.FAList = Model.FAList;
    ViewBag.AccountParra = $"/FinTransactions/EditFinTransaction, {Model.EditingFT.IdTransaction}";
}

<h2>@ViewData["Title"]</h2>
<hr />
<div class="container-sm">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="EditingFT.IdTransaction" />
        <input type="hidden" asp-for="EditingFT.IdSource" />
        <input type="hidden" asp-for="IsCreditTheSource" />
        <input type="hidden" asp-for="ReturnRoute" />
        <hr />
        <div class="row row-gap-2 mb-2 col-9">
            <div class="input-group mb-3">
                <label class="input-group-text" for="inputDate" asp-for="EditingFT.TransactionDate">Transaction date</label>
                <input type="datetime" class="form-control" asp-for="EditingFT.TransactionDate" disabled />
            </div>
            @switch(Model.IsCreditTheSource)
                {
                    case -1: // neither Debit or Credit are the IdSource
                    // restrict editing and notify
                    <div class="alert-warning pb-3"><strong>NOTE:</strong> This transaction cannot be modified.</div>
                    <div class="input-group mb-3">
                        <label class="input-group-text" for="inputDebit" asp-for="EditingFT.DebitAccount"></label>
                        <div class="form-text">@Model.FAList.Where(predicate => predicate.Value == Model.EditingFT.DebitAccount.ToString()).FirstOrDefault()?.Text</div>
                    </div>
                    <div class="input-group mb-3">
                        <label class="input-group-text" for="inputCredit" asp-for="EditingFT.CreditAccount"></label>
                        <div class="form-text">@Model.FAList.Where(predicate => predicate.Value == Model.EditingFT.CreditAccount.ToString()).FirstOrDefault()?.Text</div>
                    </div>
                        break;
                    case 0: // Debit is the IdSource
                    // alow editing of Credit
                    <div class="input-group mb-3">
                        <label class="input-group-text" asp-for="EditingFT.DebitAccount"></label>
                        <div class="form-text">@Model.FAList.Where(predicate=>predicate.Value == Model.EditingFT.DebitAccount.ToString()).FirstOrDefault()?.Text</div>
                        <input type="hidden" asp-for="EditingFT.DebitAccount" />
                    </div>
                    <div class="input-group mb-3">
                        <label class="input-group-text" for="inputCredit" asp-for="EditingFT.CreditAccount"></label>
                        <select class="form-select" id="inputCredit" asp-for="EditingFT.CreditAccount" asp-items="@ViewBag.FAList">
                            <option>Choose...</option>
                        </select>
                        <a class="btn btn-outline-secondary" asp-page="../Accounts/CreateFinancialAccount" asp-route-id="@Model.EditingFT.IdTransaction" asp-route-ift="@Model.ReturnRoute">Create Account</a>      
                    </div>
                    <span class="text-danger" asp-validation-for="EditingFT.CreditAccount"></span>
                        break;
                    case 1: // Credit is the IdSource
                    // alow editing of Debit
                    <div class="input-group mb-3">
                        <label class="input-group-text" for="inputDebit" asp-for="EditingFT.DebitAccount"></label>
                        <select class="form-select" id="inputDebit" asp-for="EditingFT.DebitAccount" asp-items="@ViewBag.FAList">
                            <option>Choose...</option>
                        </select>
                        <a class="btn btn-outline-secondary" asp-page="../Accounts/CreateFinancialAccount" asp-route-id="@Model.EditingFT.IdTransaction" asp-route-ift="@Model.ReturnRoute">Create Account</a>
                    </div>
                    <span class="text-danger" asp-validation-for="EditingFT.DebitAccount"></span>
                    <div class="input-group mb-3">
                        <label class="input-group-text" asp-for="EditingFT.CreditAccount"></label>
                        <div class="form-text">@Model.FAList.Where(predicate => predicate.Value == Model.EditingFT.CreditAccount.ToString()).FirstOrDefault()?.Text</div>
                        <input type="hidden" asp-for="EditingFT.CreditAccount" />
                    </div>
                        break;
                }
            <div class="input-group mb-3">
                <label class="input-group-text" for="inputAmount" asp-for="EditingFT.TransactionValue"></label>
                <input type="number" class="form-control" id="inputAmount" asp-for="EditingFT.TransactionValue" disabled/>
                <span class="text-body">$AUD</span>
            </div>
            @if(Model.EditingFT.IdSource > 1000000)
            {
                <div class="input-group mb-3">
                    <label class="input-group-text" for="inputDetails" asp-for="EditingFT.TransactionDetail"></label>
                    <input class="form-control" type="text" id="inputDetails" asp-for="EditingFT.TransactionDetail" disabled/>
                    <input type="hidden" asp-for="EditingFT.TransactionDetail" />
                </div>
            }
            else
            {
                <div class="input-group mb-3">
                    <label class="input-group-text" for="inputDetails" asp-for="EditingFT.TransactionDetail"></label>
                    <input class="form-control" type="text" id="inputDetails" asp-for="EditingFT.TransactionDetail" />
                    <span class="text-danger" asp-validation-for="EditingFT.TransactionDetail"></span>
                </div>
            }              
            <div class="input-group mb-3">
                <label class="input-group-text" for="inputKey">Account associated key</label>
                <input class="form-control" type="text" id="inputKey" asp-for="AccountKey" />
                <span class="text-danger" asp-validation-for="AccountKey"></span>
            </div>
            <div class="input-group mb-3">
                <label class="input-group-text" for="inputContract" asp-for="EditingFT.ContractIdentifier"></label>
                <input class="form-control" id="inputContract" asp-for="EditingFT.ContractIdentifier" disabled />
                <label class="input-group-text" for="inputContract">@Model.NameContract</label>
            </div>
            <div class="input-group mb-3">
                <label class="input-group-text" for="inputSource" asp-for="EditingFT.IdSource"></label>
                <div class="form-text" id="inputSource">@Model.FAList.Where(predicate => predicate.Value == Model.EditingFT.IdSource.ToString()).FirstOrDefault()?.Text</div>
            </div>
        </div>
        <hr />
        <div class="row row-gap-2 mb-3 col-9">
            <div class="col col-3">
                <a class="link-info" asp-page="./IndexFinTransactions" asp-route-rfe="@Model.ReturnRoute">Back to list</a>
            </div>
            <div class="col col-auto align-content-end">
                <button type="submit" class="btn btn-outline-success">Update</button>
            </div>
        </div>
    </form>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

