@page "{idxcol:int?}"
@model MyFinances.Pages.FinTransactions.ImportedKeySelectionModel
@{
    ViewData["Title"] = "Dictionary key selection";
}

<h1>@ViewData["Title"]</h1>
<hr />
<br />
<hr />
<div class="row row-gap-2 fst-italic">
    <p>NOTE: Select the key from the listed item and drag-and-drop selection in the associated Key box</p>
    <p>Alternatively type in the box the key text using as reference the listed rows</p>
</div>
<div class="row row-cols-auto row-gap-2">
    <form method="post">
        <table class="table table-borderless">
            <thead class="table-primary">
                <tr>
                    <th scope="col">Imported detail</th>
                    <th scope="col">Selected key</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ImportList)
                {

                }
                @for (int i = 0; i < Model.ImportList.Count; i++)
                {
                    <tr>
                        <td scope="col">@Model.ImportList[i]</td>
                        <td scope="col">
                            <input type="text" class="form-control" placeholder="type in the key" asp-for="@Model.KeyList[i]" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <hr />
        <br />
        <button type="submit" class="btn btn-outline-primary">Continue</button>
    </form>
</div>
<div class="row row-gap-2">
    <a asp-page="TransDictIndex">Back to dictionary</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}