@page
@model MyFinances.Pages.FinTransactions.KeyAllocationModel
@{
    ViewData["Title"] = $"Key allocation";
    ViewBag.FinAccountLI = Model.FinAccountLI;
    ViewBag.SourceLI = Model.SourceLI;
}

<h1>@ViewData["Title"]</h1>
<hr />
<hr />
<div class="row row-gap-2">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <span class="text-danger">*</span>
            <label class="form-label" aria-describedby="SelectSource">Select target for the transaction tags</label>
            <select class="form-select" id="SelectSource" asp-for="IdSourceKeys" aria-label="Select source account" asp-items="@ViewBag.SourceLI">
                <option >Choose..</option>
            </select>
        </div>
        <hr />
        <table class="table table-bordered">
            <thead>
                <tr scope="row">
                    <th>Select target account</th>
                    <th>Key detail</th>
                </tr>
            </thead>
            <tbody>
                @for(int i = 0; i < Model.KeyDictList.Count; i++)
                {
                    <input type="hidden" asp-for="KeyDictList[i].IdKey" />
                    <input type="hidden" asp-for="KeyDictList[i].IdSource" />
                    <input type="hidden" asp-for="KeyDictList[i].Name" />
                    <tr>
                        <td>
                            <select class="form-select" asp-for="KeyDictList[i].IdTarget" asp-items="@ViewBag.FinAccountLI">
                                <option value="0" >--Select target--</option>
                            </select>
                        </td>
                        <td>
                            @Model.KeyDictList[i].Name
                        </td>
                    </tr>                 
                }
            </tbody>
        </table>
        <hr />
        <button class="btn btn-outline-success" type="submit" role="button">Save</button>
    </form>
</div>
<hr />
<br />
<a class="link-info" asp-page="TransDictIndex">Back to key index</a>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        window.addEventListener("DOMContentLoaded", function () {
            if('@TempData["ErrMsg"]')
            {
                const modalBody = document.getElementById("modalBody");
                modalBody.innerHTML = '@TempData["ErrMsg"]';
                const modalContent = document.querySelector("#myModal .modal-content");
                modalContent.style.backgroundColor = "#fab972"; // calm orange
                const modal = new bootstrap.Modal(document.getElementById("myModal"));
                modal.show();
            }
        });
    </script>
}
