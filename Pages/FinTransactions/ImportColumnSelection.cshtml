@page
@using System.Data
@model MyFinances.Pages.FinTransactions.ImportColumnSelectionModel
@{
    ViewData["Title"] = @"Key selection from import transaction details";
}

<h1 class="border-bottom">@ViewData["Title"]</h1>

<hr />
<br />

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            @foreach (DataColumn dataColumn in Model.ImportTable.Columns)
            {
                <th scope="col">@dataColumn.ColumnName</th>
            }
        </tr>
    </thead>
    <tbody>
        @for(int i = 0; i < 5; i++)
        {
            <tr>
                @foreach (var col in Model.ImportTable.Columns.Cast<DataColumn>())
                {
                    <td>@Model.ImportTable.Rows[i][col]</td>
                }
            </tr>
        }
    </tbody>
</table>

<div class="row row-gap-2">
    <div class="mb-3 fst-italic">NOTE: Column numbering is starting with 1 from the most left </div>
</div>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row row-gap-2">
        <div class="col mb-3">
            <div class="input-group">
                <span class="input-group-text">Select transaction detail column</span>
                <select class="form-select" aria-label="Select column" asp-for="IndexDetail">
                    <option selected>Choose..</option>
                    @foreach (var idx in Model.ColsIndex)
                    {
                        <option value="@idx"> Column @(idx + 1)</option>
                    }
                </select>
                <span asp-validation-for="IndexDetail" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row-cols-2">
        <div class="mb-3">
            <button type="submit" class="btn btn-light">Continue</button>
        </div>
        <div class="mb-3">
            <button type="submit" class="btn btn-link" asp-page-handler="goback">Back to upload</button>
        </div>
    </div>
</form>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        window.addEventListener("DOMContentLoaded", function () {
            if(@TempData["ErrorMessage"] <> null)
            {
                const modalBody = document.getElementById("modalBody");
                modalBody.innerHTML = '@TempData["ErrorMessage"]';
                const modalContent = document.querySelector("#myModal .modal-content");
                modalContent.style.backgroundColor = "#fab972"; // calm orange
                const modal = new bootstrap.Modal(document.getElementById("myModal"));
                modal.show();
            }
        });

    </script>
}
