@page
@model MyFinances.Pages.Contracts.ContractDetailsModel

@{
}

<h1>@ViewData["Title"]</h1>
<br />
<br />
<div class="container container-sm">
    <table class="table table-secondary">
        <thead>
            <tr>
                <th>Name</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ItemDetails)
            {
                <tr>
                    <td>@item.ItemName</td>
                    <td>@item.ItemValue</td>
                </tr>
            }
        </tbody>
    </table>
    <br />
    <br />
    <div class="row">
        <div class="col">
            <a asp-page="./ContractsList">Back to List</a>
        </div>
        <div class="col align-content-end">
            <a asp-page="./ContractEdit" asp-route-pid="@Model.ItemId">Edit</a>
        </div>
    </div>
</div>
