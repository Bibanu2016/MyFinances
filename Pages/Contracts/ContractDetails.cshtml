@page
@model MyFinances.Pages.Contracts.ContractDetailsModel

@{
}

<h1>@ViewData["Title"]</h1>
<br />
<div class="container container-md">
    <div class="row" style="background-color:dodgerblue">
        <div class="col col-md-3">
            DETAIL
        </div>
        <div class="col col-md">
            VALUE
        </div>
    </div>
    <br />
    <div class="row pb-2">
        <div class="col col-md-3">
            @Html.DisplayNameFor(model => model.Full.FinContract.ContractType)
        </div>
        <div class="col col-md">
            @Html.DisplayFor(model => model.FullNames.ContractTypeName)
        </div>
    </div>
    <div class="row pb-2">
        <div class="col col-md-3">
            @Html.DisplayNameFor(model => model.Full.FinContract.ContractName)
        </div>
        <div class="col col-md">
            @Html.DisplayFor(model => model.Full.FinContract.ContractName)
        </div>
    </div>
    <div class="row pb-2">
        <div class="col col-md-3">
            @Html.DisplayNameFor(model => model.Full.FinContract.ContractDetails)
        </div>
        <div class="col col-md">
            @Html.DisplayFor(model => model.Full.FinContract.ContractDetails)
        </div>
    </div>
    <div class="row pb-2">
        <div class="col col-md-3">
            @Html.DisplayNameFor(model => model.Full.FinContract.IdOrganisation)
        </div>
        <div class="col col-md">
            @Html.DisplayFor(model => model.FullNames.OrganisationName)
        </div>
    </div>
    <div class="row pb-2">
        <div class="col col-md-3">
            @Html.DisplayNameFor(model => model.Full.FinContract.IdContractor)
        </div>
        <div class="col col-md">
            @Html.DisplayFor(model => model.FullNames.ContractortName)
        </div>
    </div>
    <div class="row pb-2">
        <div class="col col-md-3">
            @Html.DisplayNameFor(model => model.Full.FinContract.StartDate)
        </div>
        <div class="col col-md">
            @Model.Full.FinContract.StartDate.ToShortDateString()
        </div>
    </div>
    <div class="row pb-2">
        <div class="col col-md-3">
            @Html.DisplayNameFor(model => model.Full.FinContract.EndDate)
        </div>
        <div class="col col-md">
            @Model.Full.FinContract.EndDate.ToShortDateString()
        </div>
    </div>
    <div class="row pb-2">
        <div class="col col-md-3">
            @Html.DisplayNameFor(model => model.Full.FinContract.IdEndAction)
        </div>
        <div class="col col-md">
            @Html.DisplayFor(model => model.FullNames.EndActionName)
        </div>
    </div>
    <div class="row pb-2">
        <div class="col col-md-3">
            @Html.DisplayNameFor(model => model.Full.FinContract.InvoiceDate)
        </div>
        <div class="col col-md">
            @Model.Full.FinContract.InvoiceDate.ToShortDateString()
        </div>
    </div>
    <div class="row pb-2">
        <div class="col col-md-3">
            @Html.DisplayNameFor(model => model.Full.FinContract.InvoiceNetDays)
        </div>
        <div class="col col-md">
            @Html.DisplayFor(model => model.Full.FinContract.InvoiceNetDays)
        </div>
    </div>
    <div class="row pb-2">
        <div class="col col-md-3">
            @Html.DisplayNameFor(model => model.Full.FinContract.IdFrequency)
        </div>
        <div class="col col-md">
            @Html.DisplayFor(model => model.FullNames.FrequencyName)
        </div>
    </div>
    <div class="row pb-2">
        <div class="col col-md-3">
            @Html.DisplayNameFor(model => model.Full.FinContract.IdFinAccount)
        </div>
        <div class="col col-md">
            @Html.DisplayFor(model => model.Full.FinContract.IdFinAccount)
        </div>
    </div>
    <div class="row pb-2">
        <div class="col col-md-3">
            @Html.DisplayNameFor(model => model.Full.FinContract.IdPayAccount)
        </div>
        <div class="col col-md">
            @Html.DisplayFor(model => model.FullNames.PaymentAccountName)
        </div>
    </div>
    <div class="row pb-2">
        <div class="col col-md-3">
            @Html.DisplayNameFor(model => model.Full.FinContract.IdBankAccount)
        </div>
        <div class="col col-md">
            @Html.DisplayFor(model => model.FullNames.BankAccountName)
        </div>
    </div>
    <div class="row pb-2">
        <div class="col col-md-3">
            @Html.DisplayNameFor(model => model.Full.FinContract.IsActiveContract)
        </div>
        <div class="col col-md">
            @Html.DisplayFor(model => model.Full.FinContract.IsActiveContract)
        </div>
    </div>
    <div class="row pb-2">
        <div class="col col-md-3">
            @Html.DisplayNameFor(model => model.Full.FinContract.EquivMonthlyRate)
        </div>
        <div class="col col-md">
            @Html.DisplayFor(model => model.Full.FinContract.EquivMonthlyRate)
        </div>
    </div>
    @if (!Model.Full.FinContract.IsActiveContract)
    {
        <div class="row text-bg-danger">
            <div class="col col-md-3">
                @Html.DisplayNameFor(model => model.Full.FinContract.ClosedDate)
            </div>
            <div class="col col-md">
                @Model.Full.FinContract.ClosedDate.ToShortDateString();
            </div>
        </div>
    }
 
    <hr />
    @switch (Model.Full.FinContract.ContractType)
    {
        case 1:
            <div class="row pb-2">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.Deposit.DepositInitialBalance)
                </div>
                <div class="col col-md">
                     @Html.DisplayFor(model => model.Full.Deposit.DepositInitialBalance)
                </div>
            </div>
            <div class="row pb-2">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.Deposit.DepositRate)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.Full.Deposit.DepositRate)
                </div>
            </div>
            <div class="row pb-2">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.Deposit.InterestRatePerYear)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.Full.Deposit.InterestRatePerYear) %
                </div>
            </div>
            <div class="row pb-2">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.Deposit.InterestAccount)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.Full.Deposit.InterestAccount)
                </div>
            </div>
            break;
        case 2:
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.Loan.IdLoanType)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.FullNames.LoanTypeName)
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.Loan.LoanAmount)
                </div>
                <div class="col col-md">
                    AU$ @Html.DisplayFor(model => model.Full.Loan.LoanAmount)
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.Loan.LoanInterest)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.Full.Loan.LoanInterest) %
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.Loan.LoanSecurity)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.FullNames.LoanSecurityName)
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.Loan.IdAccountInterest)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.Full.Loan.IdAccountInterest)
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.Loan.ExtraPay)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.Full.Loan.ExtraPay)
                </div>
            </div>
            break;
        case 3:
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.CreditCard.CreditCardLimit)
                </div>
                <div class="col col-md">
                    Au$ @Html.DisplayFor(model => model.Full.CreditCard.CreditCardLimit)
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.CreditCard.CreditCardInterest)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.Full.CreditCard.CreditCardInterest) %
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.CreditCard.CashRate)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.Full.CreditCard.CashRate) %
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.CreditCard.CreditCardInsuranceRate)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.Full.CreditCard.CreditCardInsuranceRate) % of balance
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.CreditCard.CreditCardPayPercent)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.Full.CreditCard.CreditCardPayPercent) % of balance
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.CreditCard.CycleFee)
                </div>
                <div class="col col-md">
                    AU$ @Html.DisplayFor(model => model.Full.CreditCard.CycleFee)
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.CreditCard.ExtraPay)
                </div>
                <div class="col col-md">
                    AU$ @Html.DisplayFor(model => model.Full.CreditCard.ExtraPay)
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.CreditCard.InterestAccount)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.Full.CreditCard.InterestAccount)
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.CreditCard.InterestCashOutAcc)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.Full.CreditCard.InterestCashOutAcc)
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.CreditCard.FeeAccount)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.Full.CreditCard.FeeAccount)
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.CreditCard.InsuranceAccount)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.Full.CreditCard.InsuranceAccount)
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.CreditCard.CashOutAccount)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.Full.CreditCard.CashOutAccount)
                </div>
            </div>
            break;
        case 4:
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.Employment.GrossPaidCycle)
                </div>
                <div class="col col-md">
                    AU$ @Html.DisplayFor(model => model.Full.Employment.GrossPaidCycle)
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.Employment.TaxPaidCycle)
                </div>
                <div class="col col-md">
                    AU$ @Html.DisplayFor(model => model.Full.Employment.TaxPaidCycle)
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.Employment.SuperPaidCycle)
                </div>
                <div class="col col-md">
                    AU$ @Html.DisplayFor(model => model.Full.Employment.SuperPaidCycle)
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.Employment.IdSuperAccount)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.FullNames.SuperAccountName)
                </div>
            </div>
            break;
        case 5:
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.Income.GrossPerCycle)
                </div>
                <div class="col col-md">
                    @Html.DisplayFor(model => model.Full.Income.GrossPerCycle)
                </div>
            </div>
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.Income.TaxPaidCycle)
                </div>
                <div class="col col-md">
                   AU$ @Html.DisplayFor(model => model.Full.Income.TaxPaidCycle)
                </div>
            </div>
            break;
        case 6 or 7:
            <div class="row">
                <div class="col col-md-3">
                    @Html.DisplayNameFor(model => model.Full.Bill.BillCycleRate)
                </div>
                <div class="col col-md">
                    AU$ @Html.DisplayFor(model => model.Full.Bill.BillCycleRate)
                </div>
            </div>
            break;
    }

    <br />
    <div class="row text-warning  pb-2">
        <div class="col col-md-3 text-wrap">
            <strong>FY Months missing transactions record:</strong>
        </div>
        <div class="col col-md text-wrap">
            @Model.MissingMonths
        </div>
    </div>
    <br />
    <div class="row pb-2">
        <div class="col col-md-3">Next rate date</div>
        <div class="col col-md">@Model.NextRateDate.ToShortDateString()</div>
    </div>
    <div class="row gy-2">
        <div class="col col-md-3">Next rate value</div>
        <div class="col col-md">@Model.NextRateValue</div>
    </div>
    <br />
    <hr />
    @if(Model.Full.FinContract.ContractType < 4)
    {
        @if(Model.HasTransactions)
        {
            <div class="row pb-2">
                <div class="col col-md-3">Balance as start FY</div>
                <div class="col col-md">@Model.FYStartBalance</div>
            </div>
            <br />
            <div class="row pb-2">
                <div class="col col-md-3">Balance date</div>
                <div class="col col-md">@Model.BalanceDate.ToShortDateString()</div>
            </div>
            <div class="row pb-2">
                <div class="col col-md-3">Balance</div>
                <div class="col col-md">@Model.LastBalance</div>
            </div>
            @if(Model.Full.FinContract.ContractType == 3)
            {
                <div class="row pb-2">
                    <div class="col col-md-3">Balance cash out</div>
                    <div class="col col-md">@Model.LastCashOutBal</div>
                </div>
                <br />
                <div class="row pb-2">
                    <div class="col col-md-3">Rate for 1 year pay off</div>
                    <div class="col col-md">@Model.CardRates123[0]</div>
                </div>
                <div class="row pb-2">
                    <div class="col col-md-3">Rate for 2 year pay off</div>
                    <div class="col col-md">@Model.CardRates123[1]</div>
                </div>
                <div class="row pb-2">
                    <div class="col col-md-3">Rate for 3 year pay off</div>
                    <div class="col col-md">@Model.CardRates123[2]</div>
                </div>
            }
            <div class="row pb-2">
                <div class="col col-md-3">
                </div>
                <div class="col col-md">
                </div>
            </div>
        }
    }
</div>
<hr />
<div style="background-color:lightsteelblue" class="row">
    <div class="col col-md">
        <a asp-page="./Edit" asp-route-id="@Model.Full.FinContract.IdFinContract">Edit</a>
    </div>
    <div class="col col-md">
        <a asp-page="./ContractsList">Back to List</a>
    </div>
    <div class="col col-md">
        <a asp-page="../Index">Back Home</a>
    </div>    
</div>
