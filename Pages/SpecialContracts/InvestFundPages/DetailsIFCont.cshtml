@page "{id}"
@model MyFinances.Pages.SpecialContracts.InvestFundPages.DetailsIFContModel
@{
}

<h1>@ViewData["Title"]</h1>
<br />
<div class="container container-sm">
    <table class="table table-secondary">
        <thead>
            <tr>
                <th>Name</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model.ICDetails)
            {
                <tr>
                    <td>@item.ItemName</td>
                    <td>@item.ItemValue</td>
                </tr>
            }
            <tr>
                <td>Contract has recorded transactions</td>
                <td>@Model.IsExecuted.ToString()</td>
            </tr>
            @if (Model.IsExecuted)
            {
                <tr>
                    <td>Balance date</td>
                    <td>@Model.LRBalanceDate.ToShortDateString()</td>
                </tr>
                <tr>
                    <td>Balance values</td>
                    <td>@Model.LastRealBalance.ToString()</td>
                </tr>
            }
        </tbody>
    </table>
    <br />
    <br />
    <div class="row">
        <div class="col">
            <a asp-page="../IndexSpecialContracts">Back to List</a>
        </div>
        <div class="col align-content-end">
            <a asp-page="EditIFCont" asp-route-id="@Model.ItemID">Edit</a>
        </div>
    </div>
</div>
<br />
<br />

<div class="row">
    
</div>


