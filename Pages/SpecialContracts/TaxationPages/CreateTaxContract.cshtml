@page
@model MyFinances.Pages.SpecialContracts.TaxationPages.CreateTaxContractModel
@{
    ViewBag.Frequency = Model.Frequency;
    ViewBag.Users = Model.Users;
    ViewBag.Organisation = Model.Organisation;
}

<h1>@ViewData["Title"]</h1>
<br />
<hr />
<div class="container container-sm">
    <h4><strong>Main contract data</strong></h4>
    <div class="row pb-sm-3">
        <div class="col col-sm-3">
            <span class="text-danger">*</span>
            <label asp-for="CategoryContract" class="control-label"></label>
        </div>
        <div class="col form-text">@Model.CategoryContract - <strong>Government income tax contract</strong></div>
    </div>
    <div class="row pb-sm-3">
        <div class="col col-sm-3">
            <span class="text-danger">*</span>
            <label asp-for="MainContract.ContractName" class="control-label"></label>
        </div>
        <div class="col col-sm">
            <input type="text" asp-for="MainContract.ContractName" class="form-control" />
            <span asp-validation-for="MainContract.ContractName" class="text-danger"></span>
        </div>
    </div>
    <div class="row pb-sm-3">
        <div class="col col-3">
            <span class="text-danger">*</span>
            <label asp-for="MainContract.ContractDetails" class="control-label"></label>
        </div>
        <div class="col">
            <input type="text" asp-for="MainContract.ContractDetails" class="form-control" />
            <span asp-validation-for="MainContract.ContractDetails" class="text-danger"></span>
        </div>
    </div>
    <div class="row pb-sm-3">
        <div class="col col-3">
            <span class="text-danger">*</span>
            <label asp-for="MainContract.IdOrganisation" class="control-label"></label>
        </div>
        <div class="col">
            <div class="input-group">
                <select class="form-select" aria-label="Select organisation" asp-for="MainContract.IdOrganisation" asp-items="@ViewBag.Organisation">
                    <option selected>Choose a value..</option>
                </select>
                <a class="btn btn-outline-secondary" asp-page="/Organisations/OrgCreate" asp-route-fc="@true" asp-route-ct="22"><i class="bi-plus-circle-fill"></i></a>
            </div>
            <span asp-validation-for="MainContract.IdOrganisation" class="text-danger"></span>
        </div>
    </div>
    <div class="row pb-sm-3">
        <div class="col col-3">
            <span class="text-danger">*</span>
            <label asp-for="MainContract.IdContractor" class="control-label"></label>
        </div>
        <div class="col">
            <select class="form-select" aria-label="Select contractor" asp-for="MainContract.IdContractor" asp-items="@ViewBag.Users">
                <option selected>Choose a value..</option>
            </select>
            <span asp-validation-for="MainContract.IdContractor" class="text-danger"></span>
        </div>
    </div>
    <div class="row pb-sm-3">
        <div class="col col-3">
            <span class="text-danger">*</span>
            <label asp-for="MainContract.StartDate" class="control-label"></label>
        </div>
        <div class="col">
            <input type="date" asp-for="MainContract.StartDate" class="form-control" value="@DateTime.Today" />
            <span asp-validation-for="MainContract.StartDate" class="text-danger"></span>
        </div>
        <input type="hidden" asp-for="MainContract.EndDate" value="@DateTime.MaxValue" />
    </div>
    <input type="hidden" asp-for="MainContract.IdEndAction" value="2" />
    <div class="row pb-sm-3">
        <div class="col col-3">
            <span class="text-danger">*</span>
            <label asp-for="MainContract.InvoiceDate" class="control-label"></label>
        </div>
        <div class="col">
            <input type="date" asp-for="MainContract.InvoiceDate" class="form-control" value="@DateTime.Today" />
            <span asp-validation-for="MainContract.InvoiceDate" class="text-danger"></span>
        </div>
        <input type="hidden" asp-for="MainContract.InvoiceNetDays" value="0" />
    </div>
    <div class="row pb-sm-3">
        <div class="col col-3">
            <span class="text-danger">*</span>
            <label asp-for="MainContract.IdFrequency" class="control-label"></label>
        </div>
        <div class="col">
            <select class="form-select" aria-label="Select payment cycle" asp-for="MainContract.IdFrequency" asp-items="@ViewBag.Frequency">
                <option selected>Choose an option..</option>
            </select>
            <span asp-validation-for="MainContract.IdFrequency" class="text-danger"></span>
        </div>
    </div>
    <input type="hidden" asp-for="MainContract.IdPayAccount" value="0" />
    <input type="hidden" asp-for="MainContract.IdBankAccount" value="0" />
</div>
<br />
<div class="container-sm align-content-end">
    <div class="row justify-content-end">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col col-sm-3"></div>
            <div class="col align-content-end">
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </form>
    </div>
</div>
<br />
<div class="row">
    <a asp-page="../IndexSpecialContracts">Back to List</a>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
