@page
@model MyFinances.Pages.Accounts.IndexModel

@{
    ViewData["Title"] = "Financial Accounts List";
}

<h1>@ViewData["Title"]</h1>

@section Scripts {
    <script>
        window.addEventListener("DOMContentLoaded", function () {
            const modalBody = document.getElementById("modalBody");
            const modalContent = document.querySelector("#myModal .modal-content");
            const modal = new bootstrap.Modal(document.getElementById("myModal"));
            if('@TempData["SuccessMessage"]')
            {
                modalBody.innerHTML = '@TempData["SuccessMessage"]';
                modalContent.style.backgroundColor = "#27F5B0"; // calm green
                modal.show();
            }
            else if('@TempData["ErrorMessage"]')
            {
                modalBody.innerHTML = '@TempData["ErrorMessage"]';
                modalContent.style.backgroundColor = "#fab972"; // calm orange
                modal.show();
            }
        });
    </script>
}



<hr />
<br />
<form method="get">
    <div class="hstack gap-2">
        <div class="input-group">
            <label class="input-group-text" for="inputGroupSelect01">Account category</label>
            <select class="form-select" id="inputGroupSelect01" asp-for="CategoryFilter">
                <option value="0" selected>Choose...</option>
                @if(Model.AccCategList != null)
                {
                    @foreach(var item in Model.AccCategList)
                    {
                        <option value="@item.ItemID">@item.Name</option>
                    }
                }
            </select>
        </div>
        <div class="input-group">
            <label class="input-group-text" for="inputGroupSelect02">Owner</label>
            <select class="form-select" id="inputGroupSelect02" asp-for="OwnerFilter">
                <option value="0" selected>Choose...</option>
                @if(Model.AccUserList != null)
                {
                    @foreach(var item in Model.AccUserList)
                    {
                        <option value="@item.ItemID">@item.Name</option>
                    }
                }
            </select>
        </div>
        <button type="submit" class="btn btn-info">Filter</button>
        <a asp-page="./IndexFinAccount" class="btn btn-secondary">Reset</a>
    </div>
</form>
<br />
<hr />
<div class="row pb-3">
    <div class="col">
        <a asp-page="./CreateFinancialAccount" class="btn btn-outline-primary">Create</a>
    </div>
</div>
<hr />
<table class="table">
    <thead>
        <tr>
            <th>
                Id
            </th>
            <th>
                Name
            </th>
            <th>
                Category
            </th>
            <th>
                User
            </th>
            <th>Item action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.FAList)
        {
        <tr>
            <td>
                @item.Id
            </td>
            <td>
                @item.Name
            </td>
            <td>
                @item.Category
            </td>
            <td>
                @item.UserName
            </td>
            <td>
                <a asp-page="./EditFinAccount" asp-route-id="@item.Id"><i class="bi-pencil-fill" style="color:grey" alt="Edit"></i></a> |
                <a asp-page="./DeleteFinAccount" asp-route-id="@item.Id"><i class="bi-trash-fill" style="color:grey" alt="Delete"></i></a>
            </td>
        </tr>
}
    </tbody>
</table>
<hr />
<br />
<div class="row">
    <a asp-page="/Index">Home</a>
</div>
