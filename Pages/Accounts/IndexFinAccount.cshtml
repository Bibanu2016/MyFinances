@page
@model MyFinances.Pages.Accounts.IndexModel

@{
    ViewData["Title"] = "Financial Accounts List";
    ViewBag.ACSL = Model.ACSL;
    ViewBag.OWSL = Model.OWSL;
}

<h1>@ViewData["Title"]</h1>

@section Scripts {
    <script>
        window.addEventListener("DOMContentLoaded", function () {
            const modalBody = document.getElementById("modalBody");
            const modalContent = document.querySelector("#myModal .modal-content");
            const modal = new bootstrap.Modal(document.getElementById("myModal"));
            if('@TempData["SuccessMessage"]')
            {
                modalBody.innerHTML = '@TempData["SuccessMessage"]';
                modalContent.style.backgroundColor = "#27F5B0"; // calm green
                modal.show();
            }
            else if('@TempData["ErrorMessage"]')
            {
                modalBody.innerHTML = '@TempData["ErrorMessage"]';
                modalContent.style.backgroundColor = "#fab972"; // calm orange
                modal.show();
            }
        });
    </script>
}



<hr />
<br />
<form method="get">
    <div class="hstack gap-2">
        <div class="input-group">
            <label class="input-group-text" for="inputGroupSelect01">Account category</label>
            <select class="form-select" id="inputGroupSelect01" asp-for="CategoryFilter" asp-items="@ViewBag.ACSL">
                <option value="0" selected>Choose...</option>
            </select>
        </div>
        <div class="input-group">
            <label class="input-group-text" for="inputGroupSelect02">Owner</label>
            <select class="form-select" id="inputGroupSelect02" asp-for="OwnerFilter" asp-items="@ViewBag.OWSL">
                <option value="0" selected>Choose...</option>
            </select>
        </div>
        <button type="submit" class="btn btn-info px-4">Filter</button>
        <a asp-page="./IndexFinAccount" class="btn btn-secondary">Reset</a>
    </div>
</form>
<br />
<hr />
<a asp-page="./CreateFinancialAccount" class="btn btn-outline-primary mb-6">Create</a>
<hr />
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FilterredFAList[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FilterredFAList[0].AccountCategory)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FilterredFAList[0].AccountOwner)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FilterredFAList[0].IsLinked)
            </th>
            <th>Item action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.FAList)
        {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FAName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FACategory)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FAUser)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FALinked)
            </td>
            <td>
                @if(item.FALinked == 1)
                {
                    <a asp-page="./EditFinAccount" asp-route-id="@item.IdFinAccount"><i class="bi-pencil-fill" style="color:grey" alt="Edit"></i></a>
                }
                else
                {
                        <i class="bi-square" style="color:grey" alt="--"></i>
                }
                 | 
                @if (item.FALinked == 1)
                {
                        <a asp-page="./DeleteFinAccount" asp-route-id="@item.IdFinAccount"><i class="bi-trash-fill" style="color:grey" alt="Delete"></i></a>
                }
                else
                {
                    <i class="bi-square" style="color:grey" alt="--"></i>
                }
            </td>
        </tr>
}
    </tbody>
</table>
<hr />
<br />
<div class="row">
    <a asp-page="/Index">Home</a>
</div>
