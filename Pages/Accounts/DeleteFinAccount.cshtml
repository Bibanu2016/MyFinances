@page
@model MyFinances.Pages.Accounts.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>@ViewData["Title"]</h1>

<hr />
@if(Model.CanDelete)
{
    <div class="container-md">
        <h4>FinAccount @Model.FinAccount.IdFinAccount</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.FinAccount.Name)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.FinAccount.Name)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.FinAccount.AccountCategory)
            </dt>
            <dd class="col-sm-10">
                @Model.NameCategory
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.FinAccount.AccountOwner)
            </dt>
            <dd class="col-sm-10">
                @Model.NameOwner
            </dd>
        </dl>
        <hr />
        <div class="row">
            <div class="col"></div>
            <div class="col align-content-end justify-content-end">
                <button type="button" id="delBttn" onclick="openConfirm()">Delete</button>
            </div>
        </div>
        <form method="post" id="deleteAccount">
            <input type="hidden" asp-for="FinAccount.IdFinAccount" />
            <input type="hidden" asp-for="CanDelete" />
        </form>
    </div>
}
else
{
    <h4 class="text-danger">@ViewData["DelMessage"]</h4>
}
<hr />
<div class="row">
    <a asp-page="./IndexFinAccount">Back to List</a>
</div>
<div class="modal fade" id="confirmDialog" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="background-color:lightcoral;">

            <div class="modal-header">
                <h5 class="modal-title" id="modalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                Are you sure?
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Yes, proceed</button>
            </div>

        </div>
    </div>
</div>
<hr />


@section Scripts
{
    <script type="text/javascript">

        function openConfirm() {
            var modal = new bootstrap.Modal(document.getElementById('confirmDialog'));
            modal.show();
        }
        function confirmDelete() {
            document.getElementById('deleteAccount').submit();
        }
    </script>

}