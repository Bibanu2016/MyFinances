@page
@model MyFinances.Pages.FinContractPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FinContract[0].ContractType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinContract[0].ContractName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinContract[0].ContractDetails)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinContract[0].IdOrganisation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinContract[0].IdContractor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinContract[0].StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinContract[0].EndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinContract[0].IdEndAction)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinContract[0].InvoiceDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinContract[0].InvoiceNetDays)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinContract[0].IdFrequency)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinContract[0].IdFinAccount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinContract[0].IdPayAccount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinContract[0].IdBankAccount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinContract[0].IsActiveContract)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinContract[0].ClosedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinContract[0].EquivMonthlyRate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.FinContract) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.ContractType)
            </td>
            <td>
                @Html.DisplayFor(model => item.ContractName)
            </td>
            <td>
                @Html.DisplayFor(model => item.ContractDetails)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdOrganisation)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdContractor)
            </td>
            <td>
                @Html.DisplayFor(model => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.EndDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdEndAction)
            </td>
            <td>
                @Html.DisplayFor(model => item.InvoiceDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.InvoiceNetDays)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdFrequency)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdFinAccount)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdPayAccount)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdBankAccount)
            </td>
            <td>
                @Html.DisplayFor(model => item.IsActiveContract)
            </td>
            <td>
                @Html.DisplayFor(model => item.ClosedDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.EquivMonthlyRate)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.IdFinContract">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.IdFinContract">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.IdFinContract">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
